{"entries":[{"timestamp":1792186620734,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":22878,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":212,"length1":39,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":239,"length1":31,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"main.py","value":"\nlet 名前X = \"\"\nlet 名前Y = \"\"\nlet しきい値 = 150\nlet 重力X = 0\nlet 重力Y = 0\nlet 振動準備 = false\nlet 前回時刻 = -1\nlet 速度 = 0\nlet 送信時刻 = 0\nlet 次はX = true\nlet 今 = 0\nlet x = 0\nlet y = 0\nlet 振動 = 0\nlet 周期 = 0\nlet 新速度 = 0\nlet vx = 0\nlet vy = 0\n\nradio.setGroup(191)\n\nif (input.buttonIsPressed(Button.A)) {\n    名前X = \"AX\"\n    名前Y = \"AY\"\n    basic.showString(\"A\")\n} else {\n    名前X = \"BX\"\n    名前Y = \"BY\"\n    basic.showString(\"B\")\n}\n\n重力X = input.acceleration(Dimension.X)\n重力Y = input.acceleration(Dimension.Y)\n送信時刻 = input.runningTime()\n\nbasic.forever(function () {\n    今 = input.runningTime()\n    x = input.acceleration(Dimension.X)\n    y = input.acceleration(Dimension.Y)\n\n    // 重力成分の抽出\n    重力X = 重力X * 0.9 + x * 0.1\n    重力Y = 重力Y * 0.9 + y * 0.1\n\n    // 振動成分\n    振動 = y - 重力Y\n\n    // 振動周期の測定\n    if (振動 < 0 - しきい値) {\n        振動準備 = true\n    } else if (振動 > しきい値 && 振動準備) {\n        振動準備 = false\n\n        if (前回時刻 >= 0) {\n            周期 = 今 - 前回時刻\n            if (周期 >= 180 && 周期 <= 1200) {\n                新速度 = 20000 / 周期\n                if (新速度 > 100) {\n                    新速度 = 100\n                }\n                速度 = 速度 * 0.5 + 新速度 * 0.5\n            }\n        }\n        前回時刻 = 今\n    }\n\n    // 振動停止\n    if (前回時刻 >= 0) {\n        if (今 - 前回時刻 > 1200) {\n            速度 = 0\n            前回時刻 = -1\n        }\n    }\n\n    // 移動速度\n    vx = 速度 * 重力X / 1000\n    vy = 速度 * Math.abs(重力Y) / 1000\n\n    // 無線送信\n    if (今 - 送信時刻 >= 100) {\n        if (次はX) {\n            radio.sendValue(名前X, Math.round(vx))\n        } else {\n            radio.sendValue(名前Y, Math.round(vy))\n        }\n        次はX = !次はX\n        送信時刻 = 今\n    }\n\n    basic.pause(20)\n})\n"}]},{"timestamp":1792187210852,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":21746,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable id=\"72ZI7fe-ZY.?+./lWwwH\">しきい値</variable><variable id=\"GPL358*u-yfO9=-Gmak@\">前回時刻</variable><variable id=\"cr{Gck|zF%U3~MqC|cCT\">次はX</variable><variable id=\"GvFEn$*~1S0uTGsH$eiv\">名前X</variable><variable id=\"H.A]bkc]WJn#^n0hj66y\">名前Y</variable><variable id=\"0zVl9HL+XBDw~bRzrfcv\">重力X</variable><variable id=\"4`#CCA[kyI@J65wo4oBA\">重力Y</variable><variable id=\"iX_sku]g^J.D?KLAnbx;\">送信時刻</variable><variable id=\",/UV=?fbo5Hj5U-YR9fc\">今</variable><variable id=\"fzgg6N;7yRS.*XD56[)/\">x</variable><variable id=\"G7ny#rQ|ms.XreyY8P2|\">y</variable><variable id=\"mS.JY4n@:X!{{k1ywtQB\">振動</variable><variable id=\";z4YmNgyLWbc7zQh77/c\">振動準備</variable><variable id=\"=|}s-OKOLe7ghy0BeOM+\">周期</variable><variable id=\"Q2Bs.M_aEx+NuJ8ivD67\">新速度</variable><variable id=\"!UJK!j|?xa%CsUAE~cqJ\">速度</variable><variable id=\"u_77sPz)yV!`n#!g[pFk\">vx</variable><variable id=\"xzm]#WY*.IsL2;Y7;N+;\">vy</variable></variables><block type=\"pxt-on-start\" x=\"20\" y=\"20\"><statement name=\"HANDLER\"><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"let 今: number;\" numlines=\"1\" declaredvars=\"今\"></mutation><next><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"let x: number;\" numlines=\"1\" declaredvars=\"x\"></mutation><next><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"let y: number;\" numlines=\"1\" declaredvars=\"y\"></mutation><n